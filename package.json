{
  "name": "forgeai",
  "displayName": "ForgeAI",
  "description": "Autonomous AI coding assistant powered by Ollama",
  "version": "1.0.0",
  "publisher": "forgeai",
  "icon": "resources/kenikoolLogo.png",
  "engines": {
    "vscode": "^1.115.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forgeai.open",
        "title": "Open ForgeAI",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.manage",
        "title": "Manage ForgeAI",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.resetOnboarding",
        "title": "Reset Onboarding Tooltips",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.openRagSettings",
        "title": "Open RAG Documentation Settings",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.uiux.createDesignSystem",
        "title": "Create Design System",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.uiux.generateTokens",
        "title": "Generate Design Tokens",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.uiux.critiqueDesign",
        "title": "Critique Design",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.uiux.checkAccessibility",
        "title": "Check Accessibility",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.openSpecReview",
        "title": "Open Spec Review Panel",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.openTaskTracker",
        "title": "Open Task Tracker Panel",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.openDesignSystem",
        "title": "Open Design System Panel",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.generateSpec",
        "title": "Generate Spec from Prompt",
        "category": "ForgeAI: Spec"
      },
      {
        "command": "forgeai.loadSpec",
        "title": "Load Spec into Panels",
        "category": "ForgeAI: Spec"
      },
      {
        "command": "forgeai.runSpec",
        "title": "Run Spec (Execute Tasks)",
        "category": "ForgeAI: Spec"
      }
