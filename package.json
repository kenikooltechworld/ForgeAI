          "type": "webview",
          "icon": "resources/forgeai-icon.svg"
        },
        {
          "id": "forgeai.uiux.designSystem",
          "name": "Design System",
          "type": "webview",
          "icon": "resources/forgeai-icon.svg"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "forgeai",
        "displayName": "ForgeAI",
        "managementCommand": "forgeai.manage"
      }
    ],
    "chatParticipants": [
      {
        "id": "forgeai.assistant",
        "name": "forgeai",
        "fullName": "ForgeAI",
        "description": "Autonomous AI coding assistant",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Autonomously fix a bug"
          },
          {
            "name": "build",
            "description": "Build a feature from a goal"
          },
          {
            "name": "explain",
            "description": "Explain selected code"
          },
          {
            "name": "test",
            "description": "Generate tests for code"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "forgeai_approveSpec",
        "displayName": "Approve Spec",
        "modelDescription": "Approve a pending phase.",
        "inputSchema": {
          "type": "object",
          "required": [
            "specId"
          ],
          "properties": {
            "specId": {
              "type": "string"
            }
          }
        },
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "approveSpec"
      },
      {
        "name": "forgeai_browserClick",
        "displayName": "Browser Click",
        "modelDescription": "Click an element on the current page by selector. Use for pagination or interactions.",
        "inputSchema": {
          "type": "object",
          "required": [
            "selector"
          ],
          "properties": {
            "selector": {
              "type": "string",
              "description": "CSS selector for the element to click"
            },
            "waitForNavigation": {
              "type": "boolean",
              "description": "Wait for page navigation after click (default: true)"
            }
          }
        },
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "browserClick"
      },
      {
        "name": "forgeai_browserClose",
