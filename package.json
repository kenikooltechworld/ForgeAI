  "scripts": {
    "clean": "rimraf dist",
    "compile": "npm run compile:extension && npm run compile:webview",
    "compile:extension": "esbuild src/extension/extension.ts --bundle --outfile=dist/extension.js --external:vscode --external:cheerio --external:@lancedb/lancedb --external:playwright --platform=node --target=node24 --sourcemap",
    "compile:webview": "vite build",
    "watch": "npm run compile:extension -- --watch & vite build --watch",
    "package": "npm run compile && vsce package",
    "lint": "eslint src --ext .ts,.tsx",
    "format": "prettier --write \"src/**/*.{ts,tsx,css}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css}\"",
    "type-check": "tsc --noEmit",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage"
  },
