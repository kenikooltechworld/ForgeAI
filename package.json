    "configuration": [
      {
        "title": "ForgeAI",
        "properties": {
          "forgeai.language": {
            "type": "string",
            "default": "English",
            "enum": [
              "English",
              "Nigerian Pidgin",
              "Yoruba",
              "Igbo",
              "Hausa",
              "French",
              "Spanish",
              "Portuguese",
              "Swahili",
              "Arabic",
              "Chinese (Simplified)",
              "Hindi",
              "Japanese",
              "Korean",
              "German",
              "Italian",
              "Russian"
            ],
            "enumDescriptions": [
              "English - Default language",
              "Nigerian Pidgin - West African English-based creole",
              "Yoruba - Nigerian language",
              "Igbo - Nigerian language",
              "Hausa - Nigerian and West African language",
              "French - Français",
              "Spanish - Español",
              "Portuguese - Português",
              "Swahili - East African language",
              "Arabic - العربية",
              "Chinese (Simplified) - 简体中文",
              "Hindi - हिन्दी",
              "Japanese - 日本語",
              "Korean - 한국어",
              "German - Deutsch",
              "Italian - Italiano",
              "Russian - Русский"
            ],
            "description": "Language for AI responses. The AI will respond in your selected language while code remains in English."
          },
          "forgeai.showThinking": {
            "type": "boolean",
            "default": true,
            "description": "Show AI thinking process"
          },
          "forgeai.autonomyLevel": {
            "type": "string",
            "default": "semi-autonomous",
            "enum": [
              "supervised",
              "semi-autonomous",
              "autonomous"
            ],
            "description": "AI autonomy level"
          },
          "forgeai.ollamaBaseUrl": {
            "type": "string",
            "default": "http://localhost:11434",
            "description": "Ollama server base URL"
          },
          "forgeai.model": {
            "type": "string",
            "default": "gpt-oss:120b-cloud",
            "description": "Ollama model to use for AI responses. Must match an installed Ollama model name (e.g., 'llama3.2', 'gemma4:27b', 'gpt-oss:120b-cloud')."
          },
          "forgeai.embeddingsModel": {
            "type": "string",
            "default": "nomic-embed-text:latest",
            "description": "Ollama embedding model for RAG vector search. Must be an installed Ollama embedding model (e.g., 'nomic-embed-text:latest', 'mxbai-embed-large'). Run 'ollama pull <model>' to install."
          },
          "forgeai.enableRagBootstrap": {
            "type": "boolean",
            "default": false,
            "description": "Enable startup RAG scraping/index refresh. Keep off to maximize extension startup responsiveness."
          },
          "forgeai.search.provider": {
            "type": "string",
            "default": "auto",
            "enum": [
              "auto",
              "serpapi",
              "serpstack"
            ],
            "description": "Web search provider. Auto tries SerpAPI first, then SerpStack."
          },
          "forgeai.search.serpApiKey": {
            "type": "string",
            "default": "",
            "description": "SerpAPI API key for Google Search (get one at serpapi.com)"
          },
          "forgeai.search.serpStackKey": {
            "type": "string",
            "default": "",
            "description": "SerpStack API key for real-time SERP data (get one at serpstack.com)"
          },
          "forgeai.browser.headless": {
            "type": "boolean",
            "default": true,
            "description": "Run browser in headless mode (background) vs headful (visible window). Only used when web search APIs are unavailable and local browser fallback is needed."
          },
          "forgeai.browser.type": {
            "type": "string",
            "default": "chromium",
            "enum": [
              "chromium",
              "firefox",
              "webkit"
            ],
            "description": "Browser engine for web research"
          },
          "forgeai.browser.pageLoadTimeout": {
            "type": "number",
            "default": 30,
            "minimum": 5,
            "maximum": 120,
            "description": "Page load timeout in seconds"
          }
        }
      }
    ]
