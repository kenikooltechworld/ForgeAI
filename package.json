{
  "name": "forgeai",
  "displayName": "ForgeAI",
  "description": "Autonomous AI coding assistant powered by Ollama",
  "version": "1.0.0",
  "publisher": "forgeai",
  "icon": "resources/kenikoolLogo.png",
  "engines": {
    "vscode": "^1.115.0",
    "node": ">=24.0.0"
  },
  "categories": [
    "AI",
    "Programming Languages"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "browser": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "forgeai.open",
        "title": "Open ForgeAI",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.manage",
        "title": "Manage ForgeAI",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.resetOnboarding",
        "title": "Reset Onboarding Tooltips",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.openRagSettings",
        "title": "Open RAG Documentation Settings",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.uiux.createDesignSystem",
        "title": "Create Design System",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.uiux.generateTokens",
        "title": "Generate Design Tokens",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.uiux.critiqueDesign",
        "title": "Critique Design",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.uiux.checkAccessibility",
        "title": "Check Accessibility",
        "category": "ForgeAI: UI/UX"
      },
      {
        "command": "forgeai.openSpecReview",
        "title": "Open Spec Review Panel",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.openTaskTracker",
        "title": "Open Task Tracker Panel",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.openDesignSystem",
        "title": "Open Design System Panel",
        "category": "ForgeAI"
      },
      {
        "command": "forgeai.generateSpec",
        "title": "Generate Spec from Prompt",
        "category": "ForgeAI: Spec"
      },
      {
        "command": "forgeai.loadSpec",
        "title": "Load Spec into Panels",
        "category": "ForgeAI: Spec"
      },
      {
        "command": "forgeai.runSpec",
        "title": "Run Spec (Execute Tasks)",
        "category": "ForgeAI: Spec"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "forgeai",
          "title": "ForgeAI",
          "icon": "resources/forgeai-icon.svg"
        }
      ]
    },
    "views": {
      "forgeai": [
        {
          "id": "forgeai.chatView",
          "name": "Chat",
          "type": "webview",
          "icon": "resources/forgeai-icon.svg"
        },
        {
          "id": "forgeai.uiux.designSystem",
          "name": "Design System",
          "type": "webview",
          "icon": "resources/forgeai-icon.svg"
        }
      ]
    },
    "languageModelChatProviders": [
      {
        "vendor": "forgeai",
        "displayName": "ForgeAI",
        "managementCommand": "forgeai.manage"
      }
    ],
    "chatParticipants": [
      {
        "id": "forgeai.assistant",
        "name": "forgeai",
        "fullName": "ForgeAI",
        "description": "Autonomous AI coding assistant",
        "isSticky": true,
        "commands": [
          {
            "name": "fix",
            "description": "Autonomously fix a bug"
          },
          {
            "name": "build",
            "description": "Build a feature from a goal"
          },
          {
            "name": "explain",
            "description": "Explain selected code"
          },
          {
            "name": "test",
            "description": "Generate tests for code"
          }
        ]
      }
    ],
    "languageModelTools": [
      {
        "name": "forgeai_readFile",
        "displayName": "Read File",
        "modelDescription": "Read the contents of a file in the workspace. Use this to understand existing code before making changes.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the file"
            }
          }
        }
      },
      {
        "name": "forgeai_writeFile",
        "displayName": "Write File",
        "modelDescription": "Write or update a file in the workspace. Use this to implement code changes.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path",
            "content"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the file"
            },
            "content": {
              "type": "string",
              "description": "Content to write to the file"
            }
          }
        }
      },
      {
        "name": "forgeai_replaceText",
        "displayName": "Replace Text",
        "modelDescription": "Replace specific text in a file. Use this for targeted edits instead of rewriting entire files.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path",
            "oldText",
            "newText"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the file"
            },
            "oldText": {
              "type": "string",
              "description": "Exact text to replace"
            },
            "newText": {
              "type": "string",
              "description": "New text to insert"
            }
          }
        }
      },
      {
        "name": "forgeai_replaceRegex",
        "displayName": "Replace Regex",
        "modelDescription": "Replace text matching a regex pattern in a file. Use this for flexible code edits.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path",
            "pattern",
            "replacement"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the file"
            },
            "pattern": {
              "type": "string",
              "description": "Regular expression pattern to match"
            },
            "replacement": {
              "type": "string",
              "description": "Replacement text"
            },
            "flags": {
              "type": "string",
              "description": "Regex flags (e.g., 'g' for global)"
            }
          }
        }
      },
      {
        "name": "forgeai_listFiles",
        "displayName": "List Files",
        "modelDescription": "List files matching a glob pattern. Use this to discover files in the workspace.",
        "inputSchema": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Glob pattern to match files (e.g., '**/*.ts')"
            }
          }
        }
      },
      {
        "name": "forgeai_findFile",
        "displayName": "Find File",
        "modelDescription": "Find a file by name across the workspace. Use this when you know the filename but need to locate its path.",
        "inputSchema": {
          "type": "object",
          "required": [
            "fileName"
          ],
          "properties": {
            "fileName": {
              "type": "string",
              "description": "Exact filename to search for (e.g., 'extension.ts')"
            },
            "exactMatch": {
              "type": "boolean",
              "description": "If true, matches exact filename. If false, matches files containing the name (default: true)"
            }
          }
        }
      },
      {
        "name": "forgeai_listDirectory",
        "displayName": "List Directory",
        "modelDescription": "List contents of a directory. Use this to explore directory structure.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the directory"
            }
          }
        }
      },
      {
        "name": "forgeai_createDirectory",
        "displayName": "Create Directory",
        "modelDescription": "Create a new directory. Use this when you need to create folder structure.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path for the new directory"
            }
          }
        }
      },
      {
        "name": "forgeai_deleteFile",
        "displayName": "Delete File",
        "modelDescription": "Delete a file or directory. Use this to remove files or folders.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the file or directory to delete"
            }
          }
        }
      },
      {
        "name": "forgeai_copyFile",
        "displayName": "Copy File",
        "modelDescription": "Copy a file from source to destination. Use this to duplicate files.",
        "inputSchema": {
          "type": "object",
          "required": [
            "source",
            "destination"
          ],
          "properties": {
            "source": {
              "type": "string",
              "description": "Absolute path to the source file"
            },
            "destination": {
              "type": "string",
              "description": "Absolute path to the destination"
            }
          }
        }
      },
      {
        "name": "forgeai_renameFile",
        "displayName": "Rename File",
        "modelDescription": "Rename or move a file. Use this to reorganize files.",
        "inputSchema": {
          "type": "object",
          "required": [
            "oldPath",
            "newPath"
          ],
          "properties": {
            "oldPath": {
              "type": "string",
              "description": "Current absolute path"
            },
            "newPath": {
              "type": "string",
              "description": "New absolute path"
            }
          }
        }
      },
      {
        "name": "forgeai_getFileStats",
        "displayName": "Get File Stats",
        "modelDescription": "Get file metadata (size, timestamps, type). Use this to check file properties.",
        "inputSchema": {
          "type": "object",
          "required": [
            "path"
          ],
          "properties": {
            "path": {
              "type": "string",
              "description": "Absolute path to the file"
            }
          }
        }
      },
      {
        "name": "forgeai_watchFiles",
        "displayName": "Watch Files",
        "modelDescription": "Watch files for changes. Use this to monitor file system events.",
        "inputSchema": {
          "type": "object",
          "required": [
            "pattern"
          ],
          "properties": {
            "pattern": {
              "type": "string",
              "description": "Glob pattern to watch (e.g., '**/*.ts')"
            }
          }
        }
      },
      {
        "name": "forgeai_findFiles",
        "displayName": "Find Files",
        "modelDescription": "Search for files with include/exclude patterns. Use this to find specific files.",
        "inputSchema": {
          "type": "object",
          "required": [
            "include"
          ],
          "properties": {
            "include": {
              "type": "string",
              "description": "Glob pattern to include"
            },
            "exclude": {
              "type": "string",
              "description": "Glob pattern to exclude (optional)"
            }
          }
        }
      },
      {
        "name": "forgeai_searchInFiles",
        "displayName": "Search In Files",
        "modelDescription": "Search for text content in files. Use this to find code patterns or specific text.",
        "inputSchema": {
          "type": "object",
          "required": [
            "query"
          ],
          "properties": {
            "query": {
              "type": "string",
              "description": "Text to search for"
            },
            "filePattern": {
              "type": "string",
              "description": "Glob pattern to limit search (optional)"
            }
          }
        }
      },
      {
        "name": "forgeai_runCommand",
        "displayName": "Run Command",
        "modelDescription": "Execute a shell command and return stdout, stderr, and exit code. Use this to run commands programmatically and get the output.",
        "inputSchema": {
          "type": "object",
          "required": [
            "command"
          ],
          "properties": {
            "command": {
              "type": "string",
              "description": "Shell command to execute (e.g., 'npm test', 'git status')"
            },
            "cwd": {
              "type": "string",
              "description": "Working directory for command execution (optional)"
            },
            "timeout": {
              "type": "number",
              "description": "Timeout in milliseconds (optional, defaults to 30000ms)"
            }
          }
        }
      },
      {
        "name": "forgeai_createTerminal",
        "displayName": "Create Terminal",
        "modelDescription": "Create a VS Code terminal for interactive command execution. Use this for long-running processes or commands that need user interaction.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string",
              "description": "Terminal name (optional)"
            },
            "cwd": {
              "type": "string",
              "description": "Working directory (optional)"
            },
            "command": {
              "type": "string",
              "description": "Command to execute in the terminal (optional)"
            }
          }
        }
      },
      {
        "name": "forgeai_generateDiff",
        "displayName": "Generate Diff",
        "modelDescription": "Generate a code diff to show proposed changes before applying them. Use this ONLY when the user explicitly asks to preview changes or see a diff. For normal code modifications, use forgeai_writeFile directly.",
        "inputSchema": {
          "type": "object",
          "required": [
            "file",
            "originalContent",
            "newContent"
          ],
          "properties": {
            "file": {
              "type": "string",
              "description": "File path relative to workspace root"
            },
            "originalContent": {
              "type": "string",
              "description": "Original file content"
            },
            "newContent": {
              "type": "string",
              "description": "New file content with changes"
            },
            "language": {
              "type": "string",
              "description": "Programming language for syntax highlighting (optional)"
            }
          }
        }
      },
      {
        "name": "forgeai_getDiagnostics",
        "displayName": "Get Diagnostics",
        "modelDescription": "Get compilation errors, type errors, and warnings for specific files. Use this after modifying files to check for errors before running tests. This is CRITICAL for intelligent error detection.",
        "inputSchema": {
          "type": "object",
          "required": [
            "paths"
          ],
          "properties": {
            "paths": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Array of absolute file paths to check for diagnostics"
            }
          }
        }
      },
      {
        "name": "forgeai_getErrors",
        "displayName": "Get All Errors",
        "modelDescription": "Get all compilation errors and warnings in the workspace. Use this to check overall project health.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "forgeai_gitStatus",
        "displayName": "Git Status",
        "modelDescription": "Get current Git status including branch name, changes, staged files, and sync status (ahead/behind remote). Use this to understand the current state of the repository.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "forgeai_gitCommit",
        "displayName": "Git Commit",
        "modelDescription": "Stage and commit changes with a commit message. Optionally stage only specific files. Use this to save changes to the repository.",
        "inputSchema": {
          "type": "object",
          "required": [
            "message"
          ],
          "properties": {
            "message": {
              "type": "string",
              "description": "Commit message"
            },
            "files": {
              "type": "array",
              "items": {
                "type": "string"
              },
              "description": "Optional: Array of file paths to stage. If not provided, stages all changes."
            },
            "amend": {
              "type": "boolean",
              "description": "Optional: Amend the previous commit instead of creating a new one"
            }
          }
        }
      },
      {
        "name": "forgeai_gitPush",
        "displayName": "Git Push",
        "modelDescription": "Push commits to the remote repository. Use this to sync local commits with the remote.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "forgeai_gitPull",
        "displayName": "Git Pull",
        "modelDescription": "Pull commits from the remote repository. Use this to sync remote changes to local.",
        "inputSchema": {
          "type": "object",
          "properties": {}
        }
      },
      {
        "name": "forgeai_gitCreateBranch",
        "displayName": "Git Create Branch",
        "modelDescription": "Create a new Git branch and optionally checkout to it. Use this to start working on a new feature or fix.",
        "inputSchema": {
          "type": "object",
          "required": [
            "name"
          ],
          "properties": {
            "name": {
              "type": "string",
              "description": "Branch name"
            },
            "checkout": {
              "type": "boolean",
              "description": "Whether to checkout the new branch (default: true)"
            }
}
      }
    },
    {
      "name": "forgeai_webSearch",
      "displayName": "Web Search",
      "modelDescription": "Search the web using cloud APIs. No local browser required. Returns URLs with snippets and auto-fetches top pages.",
      "inputSchema": {
        "type": "object",
        "required": ["query"],
        "properties": {
          "query": {
            "type": "string",
            "description": "The search query (e.g., 'React useEffect documentation')"
          }
        }
      }
    },
    {
      "name": "forgeai_webResearch",
      "displayName": "Web Research",
      "modelDescription": "Deep research with multiple queries and content aggregation. Use for comprehensive topic investigation.",
      "inputSchema": {
        "type": "object",
        "required": ["topic"],
        "properties": {
          "topic": {
            "type": "string",
            "description": "The research topic (e.g., 'Next.js App Router vs Pages Router')"
          },
          "subQueries": {
            "type": "array",
            "items": { "type": "string" },
            "description": "Optional specific sub-queries (max 3)"
          }
        }
      }
    },
    {
      "name": "forgeai_searchDocs",
      "displayName": "Search Docs",
      "modelDescription": "Search for official documentation of a library or framework. No local browser needed.",
      "inputSchema": {
        "type": "object",
        "required": ["library"],
        "properties": {
          "library": {
            "type": "string",
            "description": "Library or framework name (e.g., 'React', 'Django')"
          },
          "topic": {
            "type": "string",
            "description": "Specific topic within the library (optional)"
          }
        }
      }
    },
    {
      "name": "forgeai_fetchPage",
      "displayName": "Fetch Page",
      "modelDescription": "Fetch the full HTML content of a URL. Use this after webSearch to get real documentation.",
      "inputSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "description": "Full URL to fetch (e.g., 'https://react.dev/learn/thinking-in-react')"
          },
          "maxLength": {
            "type": "number",
            "description": "Characters per chunk (default: 15000, max: 25000)"
          },
          "offset": {
            "type": "number",
            "description": "Character offset for pagination"
          }
        }
      }
    },
    {
      "name": "forgeai_browser_navigate",
      "displayName": "Browser Navigate",
      "modelDescription": "Navigate to a URL using local Playwright browser. Requires 'npx playwright install chromium'.",
      "inputSchema": {
        "type": "object",
        "required": ["url"],
        "properties": {
          "url": {
            "type": "string",
            "description": "The URL to navigate to"
          },
          "waitForSelector": {
            "type": "string",
            "description": "Optional: Wait for a specific CSS selector"
          }
        }
      }
    },
    {
      "name": "forgeai_browser_extract",
      "displayName": "Browser Extract",
      "modelDescription": "Extract text from the current browser page after navigation. Call after forgeai_browser_navigate.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "description": "CSS selector to extract specific element content"
          },
          "maxLength": {
            "type": "number",
            "description": "Maximum characters to return (default: 8000)"
          }
        }
      }
    },
    {
      "name": "forgeai_browser_click",
      "displayName": "Browser Click",
      "modelDescription": "Click an element on the current page by selector. Use for pagination or interactions.",
      "inputSchema": {
        "type": "object",
        "required": ["selector"],
        "properties": {
          "selector": {
            "type": "string",
            "description": "CSS selector for the element to click"
          },
          "waitForNavigation": {
            "type": "boolean",
            "description": "Wait for page navigation after click (default: true)"
          }
        }
      }
    },
    {
      "name": "forgeai_browser_fill",
      "displayName": "Browser Fill",
      "modelDescription": "Fill an input field on the current page. Use to enter search queries or form data.",
      "inputSchema": {
        "type": "object",
        "required": ["selector", "value"],
        "properties": {
          "selector": {
            "type": "string",
            "description": "CSS selector for the input element"
          },
          "value": {
            "type": "string",
            "description": "Value to fill into the input field"
          },
          "pressEnter": {
            "type": "boolean",
            "description": "Press Enter after filling (default: true)"
          }
        }
      }
    },
    {
      "name": "forgeai_browser_screenshot",
      "displayName": "Browser Screenshot",
      "modelDescription": "Take a screenshot of the current browser page. Returns base64-encoded PNG.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "selector": {
            "type": "string",
            "description": "CSS selector for a specific element to screenshot"
          }
        }
      }
    },
    {
      "name": "forgeai_browser_scroll",
      "displayName": "Browser Scroll",
      "modelDescription": "Scroll the current page up, down, top, or bottom.",
      "inputSchema": {
        "type": "object",
        "properties": {
          "direction": {
            "type": "string",
            "enum": ["up", "down", "top", "bottom"],
            "description": "Direction to scroll"
          },
          "amount": {
            "type": "number",
            "description": "Pixels to scroll (default: 800)"
          }
        }
      }
    },
    {
      "name": "forgeai_browser_close",
      "displayName": "Browser Close",
      "modelDescription": "Close the browser session and free resources.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "forgeai_createDesignSystem",
      "displayName": "Create Design System",
      "modelDescription": "Create a design system with tokens, components, and themes. Use for UI/UX work.",
      "inputSchema": {
        "type": "object",
        "required": ["name", "primaryColor"],
        "properties": {
          "name": {
            "type": "string",
            "description": "Design system name"
          },
          "primaryColor": {
            "type": "string",
            "description": "Primary brand color in hex format"
          }
        }
      }
    },
    {
      "name": "forgeai_generateDesignTokens",
      "displayName": "Generate Design Tokens",
      "modelDescription": "Generate design tokens (colors, spacing, typography) from a design system.",
      "inputSchema": {
        "type": "object",
        "required": ["format"],
        "properties": {
          "format": {
            "type": "string",
            "enum": ["json", "css", "tailwind", "all"],
            "description": "Token export format"
          }
        }
      }
    },
    {
      "name": "forgeai_exportTokens",
      "displayName": "Export Tokens",
      "modelDescription": "Export design tokens to a file in the specified format.",
      "inputSchema": {
        "type": "object",
        "required": ["filePath"],
        "properties": {
          "filePath": {
            "type": "string",
            "description": "Output file path for the tokens"
          },
          "format": {
            "type": "string",
            "enum": ["json", "css", "tailwind", "scss", "js"],
            "description": "Export format (default: json)"
          }
        }
      }
    },
    {
      "name": "forgeai_checkContrast",
      "displayName": "Check Contrast",
      "modelDescription": "Check WCAG color contrast compliance between foreground and background colors.",
      "inputSchema": {
        "type": "object",
        "required": ["foreground", "background"],
        "properties": {
          "foreground": {
            "type": "string",
            "description": "Foreground color (hex, rgb, or hsl)"
          },
          "background": {
            "type": "string",
            "description": "Background color (hex, rgb, or hsl)"
          }
        }
      }
    },
    {
      "name": "forgeai_createSpec",
      "displayName": "Create Spec",
      "modelDescription": "Create a new specification for a feature or system. Starts the spec-driven development workflow.",
      "inputSchema": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "title": {
            "type": "string",
            "description": "Spec title"
          },
          "description": {
            "type": "string",
            "description": "Spec description (optional)"
          }
        }
      }
    },
    {
      "name": "forgeai_writeSpecArtifact",
      "displayName": "Write Spec Artifact",
      "modelDescription": "Write an artifact file for the current spec (requirements.md, tasks.md, design.md, etc.).",
      "inputSchema": {
        "type": "object",
        "required": ["specId", "artifactId", "content"],
        "properties": {
          "specId": {
            "type": "string",
            "description": "Spec identifier"
          },
          "artifactId": {
            "type": "string",
            "description": "Artifact name (requirements, tasks, design, plan, tests, implementation, etc.)"
          },
          "content": {
            "type": "string",
            "description": "Artifact content to write"
          }
        }
      }
    },
    {
      "name": "forgeai_readSpec",
      "displayName": "Read Spec",
      "modelDescription": "Read a spec and its artifacts. Returns spec metadata and file contents.",
      "inputSchema": {
        "type": "object",
        "required": ["specId"],
        "properties": {
          "specId": {
            "type": "string",
            "description": "Spec identifier to read"
          },
          "artifactId": {
            "type": "string",
            "description": "Specific artifact to read (optional, returns all if omitted)"
          }
        }
      }
    },
    {
      "name": "forgeai_listSpecs",
      "displayName": "List Specs",
      "modelDescription": "List all specs in the workspace.",
      "inputSchema": {
        "type": "object",
        "properties": {}
      }
    },
    {
      "name": "forgeai_continueSpec",
