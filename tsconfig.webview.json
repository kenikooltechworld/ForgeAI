{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "outDir": "./dist",
    "rootDir": "./src/webview",
    "types": ["vite/client"]
  },
  "include": ["src/webview/**/*"],
  "exclude": ["node_modules", "dist"]
}
